# Beta cerrado: oculta “crear cuenta” y usa mensajes de login solo beta; combinar con APP_AUTH_INVITE_ONLY_REGISTRATION=true en el backend.
# VITE_PUBLIC_INVITE_ONLY=false

# (Retirado) Coming soon ya no envuelve la app; beta abierta usa VITE_PUBLIC_INVITE_ONLY + landing en /.
# Frase para el modal oculto de testers (visible en el bundle del cliente — solo cortina de marketing).
# VITE_TESTER_ACCESS_CODE=

# URL canónica del frontend (https://…, sin barra final). Opcional: por defecto el build usa https://tarantulapp.com
# (sitemap.xml, robots.txt y middleware de dev/preview). Define esta variable solo para staging u otro dominio.
# También alimenta enlaces compartibles (?ref=, casos sex-ID): en Capacitor/vite sin esta variable, localhost
# se sustituye por https://tarantulapp.com para no mandar invitados a http://localhost.
# VITE_PUBLIC_SITE_URL=https://staging.ejemplo.com
# VITE_PUBLIC_SITE_URL=http://localhost:5173

# Build / preview del frontend contra tu API en producción (sin proxy de Vite).
# En desarrollo, `.env.development` deja VITE_API_URL vacío para usar el proxy de Vite (recomendado).
VITE_API_URL=
#
# Capacitor / Android Emulator → backend en tu PC (Spring + Postgres en el host):
#   npm run build -- --mode android-emulator
# Requiere `.env.android-emulator` con, por ejemplo:
#   VITE_API_URL=http://10.0.2.2:8080
# (10.0.2.2 es el alias del host desde el emulador; en navegador sigue valiendo el proxy con URL vacía.)
# Teléfono físico mismo WiFi: usa la IP LAN de tu PC, ej. http://192.168.1.42:8080 — añade ese host al
# network_security_config.xml del proyecto Android o usa HTTPS.

# Opcional: versión mostrada en Cuenta / Acerca
VITE_APP_VERSION=1.0.3

# Opcional: correo de soporte (mailto) en Cuenta; si no se define, se usa support@tarantulapp.com
VITE_SUPPORT_EMAIL=

# Opcional: Google OAuth Client ID (Google Identity Services, login social en /login)
VITE_GOOGLE_CLIENT_ID=

# (Retirado) VITE_ADMIN_EMAILS — el backend envía admin:true en AuthResponse leyendo users.is_admin (V65);
# APP_ADMIN_EMAILS en el servidor sigue siendo el bootstrap inicial. No reintroduzcas en el bundle: leak de PII/ops.
