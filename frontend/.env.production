# Valores por defecto del build de producción. En Vercel define VITE_PUBLIC_INVITE_ONLY y demás — ver `.env.example`.
# Ya no se usa pantalla “coming soon” a nivel app; quita VITE_PUBLIC_COMING_SOON del panel si aún existe.
#
# Obligatorio para app Android (Capacitor): sin URL absoluta, /api se resuelve al WebView (localhost) y el login falla.
VITE_API_URL=https://api.tarantulapp.com
VITE_APP_VERSION=1.0.18
VITE_PUBLIC_SITE_URL=https://tarantulapp.com
